#--------------------------------
# memo
#--------------------------------
# compose 全体で共有する変数を定義する場所
# ノードごとに違う値（node.name など）はここではなく docker-compose 側に書く

#--------------------------------
# elastic
#--------------------------------
# ES / Kibana 共通のイメージタグ（本番 Cloud に合わせた版）
STACK_VERSION=8.5.2

# クラスタ名。同じ名前のノード同士だけが1つのクラスタになる
CLUSTER_NAME=es-lab

# ホスト（PC）側に公開する ES のポート → コンテナ内 9200 に対応
ES_PORT=9200

# 各 ES コンテナのメモリ上限（バイト）。2147483648 = 2GB
MEM_LIMIT=2147483648

# ES の Java ヒープ。目安はコンテナ上限の約半分（ここでは 1GB）
ES_JAVA_OPTS=-Xms1g -Xmx1g

#--------------------------------
# kibana
#--------------------------------
# ホスト側に公開する Kibana のポート → コンテナ内 5601 に対応
KIBANA_PORT=5601

# Kibana コンテナのメモリ上限（バイト）。1073741824 = 1GB
KIBANA_MEM_LIMIT=1073741824
